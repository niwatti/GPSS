<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <GpssSourceRoot>$(MSBuildThisFileDirectory)../../../src</GpssSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Gpss.Core"><HintPath>$(GpssSourceRoot)/Gpss.Core/bin/Release/net10.0/Gpss.Core.dll</HintPath></Reference>
    <Reference Include="Gpss.Application"><HintPath>$(GpssSourceRoot)/Gpss.Application/bin/Release/net10.0/Gpss.Application.dll</HintPath></Reference>
    <Reference Include="Gpss.Input.Abstractions"><HintPath>$(GpssSourceRoot)/Gpss.Input.Abstractions/bin/Release/net10.0/Gpss.Input.Abstractions.dll</HintPath></Reference>
    <Reference Include="Gpss.Input.XInput"><HintPath>$(GpssSourceRoot)/Gpss.Input.XInput/bin/Release/net10.0/Gpss.Input.XInput.dll</HintPath></Reference>
  </ItemGroup>
</Project>
